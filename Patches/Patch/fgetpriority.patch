index 000000000000..f316b5a86082
--- /dev/null
+++ b/drivers/fgetpriority/main.c
@@ -0,0 +1,158 @@
+
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2026 \xx
+ *
