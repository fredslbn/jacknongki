diff --git a/drivers/fgetpriority/Makefile b/drivers/fgetpriority/Makefile
new file mode 100644
index 000000000000..9cdbf5b6dd0f
--- /dev/null
+++ b/drivers/fgetpriority/Makefile
@@ -0,0 +1,51 @@
+# NOTE: unity build. single unit.
+
+obj-$(CONFIG_FGETPRIORITY) += fgetpriority.o
+fgetpriority-y := main.o
+
+# CFLAGS_main.o += -Weverything
+# CFLAGS_main.o += $(call cc-option, -Wno-unsafe-buffer-usage)
+
+# warnings are warnings.
+CFLAGS_REMOVE_main.o += -Werror
+
+CFLAGS_main.o += -Wall
+CFLAGS_main.o += $(call cc-option, -Wno-declaration-after-statement)
+CFLAGS_main.o += $(call cc-option, -Wno-deprecated-octal-literals)
+CFLAGS_main.o += $(call cc-option, -Wno-int-to-pointer-cast)
+CFLAGS_main.o += $(call cc-option, -Wno-pointer-to-int-cast)
+CFLAGS_main.o += $(call cc-option, -Wno-int-conversion)
+CFLAGS_main.o += $(call cc-option, -Wno-unused-variable)
+CFLAGS_main.o += $(call cc-option, -Wno-unused-function)
+CFLAGS_main.o += $(call cc-option, -Wno-format)
+CFLAGS_main.o += $(call cc-option, -Wno-c2x-extensions)
+
+# enforce atleast gnu11
+CFLAGS_main.o += $(call cc-option, -std=gnu11)
+CFLAGS_main.o += $(call cc-option, -std=gnu17)
+CFLAGS_main.o += $(call cc-option, -std=gnu23)
+CFLAGS_main.o += $(call cc-option, -std=gnu2y)
+
+ifeq ($(CONFIG_CC_OPTIMIZE_FOR_SIZE),y)
+CFLAGS_REMOVE_main.o += -Oz
+CFLAGS_REMOVE_main.o += -Os
+CFLAGS_main.o += -O2
+endif
+
+CFLAGS_main.o += $(call cc-option, -Wframe-larger-than=1024)
+
+CFLAGS_REMOVE_main.o += -fno-builtin
+
+CFLAGS_main.o += -g0 -fno-unwind-tables -fno-asynchronous-unwind-tables -fomit-frame-pointer
+CFLAGS_main.o += $(call cc-option, -momit-leaf-frame-pointer)
+
+CFLAGS_REMOVE_main.o += $(CC_FLAGS_FTRACE)
+CFLAGS_REMOVE_main.o += -pg
+
+CFLAGS_REMOVE_main.o += -ftrivial-auto-var-init=pattern
+CFLAGS_REMOVE_main.o += -ftrivial-auto-var-init=zero
+CFLAGS_REMOVE_main.o += -enable-trivial-auto-var-init-zero-knowing-it-will-be-removed-from-clang
+
+# if cflags can be macro'd, this will be called 'TRUST_ME'
+CFLAGS_main.o += -fno-stack-protector -fno-stack-check
+CFLAGS_REMOVE_main.o += -fsanitize=shadow-call-stack
diff --git a/drivers/fgetpriority/Makefile.ddk b/drivers/fgetpriority/Makefile.ddk
new file mode 100644
index 000000000000..ff92b0d7dd6d
--- /dev/null
+++ b/drivers/fgetpriority/Makefile.ddk
@@ -0,0 +1,17 @@
+CONFIG_NAME := FGETPRIORITY
+MODULE_NAME := fgetpriority
+obj-$(CONFIG_$(CONFIG_NAME)) += $(MODULE_NAME).o
+$(MODULE_NAME)-m := main.o
+
+export CONFIG_$(CONFIG_NAME)=m
+
+MDIR := $(realpath $(dir $(abspath $(lastword $(MAKEFILE_LIST)))))
+
+$(info -- KDIR: $(KDIR))
+$(info -- MDIR: $(MDIR))
+
+modules:
+	make -C $(KDIR) M=$(MDIR) EXTRA_CFLAGS="-w" modules
+	cp $(MDIR)/$(MODULE_NAME).ko $(KO_INSTALL_DIR)/$(KMI)_arm64_$(MODULE_NAME).ko
+clean:
+	make -C $(KDIR) M=$(MDIR) clean
diff --git a/drivers/fgetpriority/README.md b/drivers/fgetpriority/README.md
new file mode 100644
index 000000000000..21e678620412
--- /dev/null
+++ b/drivers/fgetpriority/README.md
@@ -0,0 +1,25 @@
+### fgetpriority
+
+A small LKM to filter sys_getpriority / sys_setpriority / sys_ioprio_get / sys_ioprio_set
+
+Usage (if LKM):
+
+```shell
+#!/bin/sh
+
+kptr_set=$(cat /proc/sys/kernel/kptr_restrict)
+echo 1 > /proc/sys/kernel/kptr_restrict
+native_sct=$(grep " sys_call_table$" /proc/kallsyms | awk {'print "0x"$1'})
+compat_sct=$(grep " compat_sys_call_table$" /proc/kallsyms | awk {'print "0x"$1'})
+echo $kptr_set > /proc/sys/kernel/kptr_restrict
+
+insmod fgetpriority.ko native_sct_param="$native_sct" compat_sct_param="$compat_sct"
+
+```
+Note: if you do NOT want to hook compat_sys_call_table, just pass compat_sct_param=0x0
+
+Compatibility:
+- CONFIG_KALLSYMS_ALL=y is required if built as module.
+
+Usage (if built-in):
+- just compile it in :^)
diff --git a/drivers/fgetpriority/build_ddk.sh b/drivers/fgetpriority/build_ddk.sh
new file mode 100755
index 000000000000..e7ed3e0713fc
--- /dev/null
+++ b/drivers/fgetpriority/build_ddk.sh
@@ -0,0 +1,46 @@
+#!/usr/bin/env bash
+
+export DDK_ROOT=/opt/ddk
+export CROSS_COMPILE=aarch64-linux-gnu-
+export ARCH=arm64
+export LLVM=1
+export LLVM_IAS=1
+
+MODULE_DIR=$PWD/../module
+export KO_INSTALL_DIR=$MODULE_DIR/ko
+rm -rf $KO_INSTALL_DIR &>/dev/null || true
+mkdir $KO_INSTALL_DIR &>/dev/null || true
+
+ORIGINAL_PATH=$PATH
+
+KMI_CLANG=(
+    android12-5.10:clang-r416183b
+    android13-5.10:clang-r450784e
+    android13-5.15:clang-r450784e
+    android14-5.15:clang-r487747c
+    android14-6.1:clang-r487747c
+    android15-6.6:clang-r510928
+    android16-6.12:clang-r536225
+    android17-6.18:clang-r584948c
+)
+
+set -e
+
+for pair in "${KMI_CLANG[@]}"
+do
+    export KMI=${pair%:*}
+    export KDIR=$DDK_ROOT/kdir/$KMI
+    export CLANG_PATH=$DDK_ROOT/clang/${pair#*:}/bin
+    export PATH=$CLANG_PATH:$ORIGINAL_PATH
+
+    make -f Makefile.ddk clean
+    make -f Makefile.ddk modules
+    make -f Makefile.ddk clean
+done
+
+cd $MODULE_DIR
+
+VERSION=$(grep version= module.prop | cut -f2 -d=)
+
+rm -f fgetpriority*.zip
+zip -r fgetpriority_$VERSION.zip *
