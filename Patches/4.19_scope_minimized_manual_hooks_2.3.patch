From b85c0bfbbd0db47dad1aac07eb2f81c7a58e2a80 Mon Sep 17 00:00:00 2001
From: backslashxx <118538522+backslashxx@users.noreply.github.com>
Date: Tue, 18 Aug 2026 09:31:51 +0800
Subject: [PATCH] KernelSU: scope minimized manual hooks 2.3

---
 fs/exec.c       |  4 ++++
 fs/open.c       |  4 ++++
 fs/stat.c       | 22 ++++++++++++++++++++++
 kernel/reboot.c |  4 ++++
 4 files changed, 34 insertions(+)

diff --git a/fs/exec.c b/fs/exec.c
index eeee7c9cca39..bc32444e3457 100644
--- a/fs/exec.c
+++ b/fs/exec.c
@@ -1741,6 +1741,10 @@ static int do_execveat_common(int fd, struct filename *filename,
 	struct files_struct *displaced;
 	int retval;
 
+#ifdef CONFIG_KSU
+	extern int ksu_handle_execveat(int *, struct filename **, void *, void *, int *);
+	[[clang::always_inline]] ksu_handle_execveat(&fd, &filename, &argv, &envp, &flags);
+#endif
 	if (IS_ERR(filename))
 		return PTR_ERR(filename);
 
diff --git a/kernel/reboot.c b/kernel/reboot.c
index 2946ed1d99d4..3d2c7039a714 100644
--- a/kernel/reboot.c
+++ b/kernel/reboot.c
@@ -312,6 +312,10 @@ SYSCALL_DEFINE4(reboot, int, magic1, int, magic2, unsigned int, cmd,
 	char buffer[256];
 	int ret = 0;
 
+#if defined(CONFIG_KSU) && !defined(CONFIG_KSU_KPROBES_KSUD)
+	extern int ksu_handle_sys_reboot(int, int, unsigned int, void __user **);
+	ksu_handle_sys_reboot(magic1, magic2, cmd, &arg);
+#endif
 	/* We only trust the superuser with rebooting the system. */
 	if (!ns_capable(pid_ns->user_ns, CAP_SYS_BOOT))
 		return -EPERM;
